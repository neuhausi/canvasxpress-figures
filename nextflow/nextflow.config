// Two ways to get the renderer: the pinned image (reproducible across machines) or a
// local install (fast iteration). The engine version is recorded in the manifest either way.
params.engine = '69.8'
profiles {
    docker {
        docker.enabled = true
        process.container = "ghcr.io/neuhausi/cxplot:${params.engine}"
        // the image's ENTRYPOINT is cxplot; Nextflow runs `bash -c`, so call it by path
        params.cxplot = 'cxplot'
        docker.runOptions = '--entrypoint ""'
    }
    local {
        docker.enabled = false
    }
}
